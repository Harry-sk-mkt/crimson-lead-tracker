{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(node *)",
      "Bash(npx clasp *)",
      "Bash(clasp push *)",
      "Bash(clasp status *)",
      "Bash(clasp run *)",
      "Bash(clasp --help)",
      "Bash(clasp --version)",
      "Bash(clasp deployments *)",
      "Bash(clasp open *)",
      "Bash(bash scripts/*)",
      "Bash(gh repo *)",
      "PowerShell(gh repo *)",
      "PowerShell(git clone *)",
      "Skill(update-config)",
      "WebSearch",
      "WebFetch(domain:docs.google.com)",
      "WebFetch(domain:developers.kakao.com)",
      "WebFetch(domain:openai.com)",
      "mcp__claude_ai_Notion__notion-search",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-query-data-sources"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/start-session.sh 2>&1",
            "timeout": 30,
            "statusMessage": "Running session-start git sync check..."
          }
        ]
      }
    ]
  }
}
